{
	"cli_default_open_behavior": "existing_window",
 "outline_panel": {
		"dock": "right",
	},
	"git_panel": {
		"dock": "left",
	},
	"selection_highlight": true,
	"rounded_selection": true,
	"buffer_line_height": "comfortable",
	"agent_servers": {
		"pi-acp": {
   "default_config_options": {
    "thought_level": "high",
    "model": "openai-codex/gpt-5.6-sol"
   },
   "type": "registry"
  },
  "opencode": {
			"type": "registry",
		},
		"codex-acp": {
			"default_config_options": {
				"model": "gpt-5.6-luna",
    "mode": "agent-full-access",
    "reasoning_effort": "medium",
			},
			"type": "registry",
		},
	},
	"base_keymap": "Atom",
	"show_edit_predictions": true,
	"edit_predictions": {
		"provider": "zed",
	},
	"terminal": {
		"font_family": "Hack",
		"shell": {
			"program": "zsh",
		},
		"cursor_shape": "bar",
		"font_size": 14.0,
	},
	"window_decorations": "client",
	"tabs": {
		"show_close_button": "hover",
	},
	"collaboration_panel": {
		"dock": "right",
		"button": false,
	},
	"file_finder": {
		"file_icons": true,
	},
	"colorize_brackets": true,
	"inlay_hints": {
		"enabled": false,
	},
	"show_whitespaces": "trailing",
	"indent_guides": {
		"background_coloring": "disabled",
		"coloring": "indent_aware",
		"active_line_width": 2,
		"line_width": 2,
	},
	"hard_tabs": true,
	"tab_size": 3,
	"toolbar": {
		"code_actions": true,
		"agent_review": true,
		"quick_actions": true,
		"breadcrumbs": true,
	},
	"scrollbar": {
		"selected_symbol": false,
		"selected_text": false,
		"cursors": false,
		"show": "auto",
	},
	"relative_line_numbers": "disabled",
	"gutter": {
		"line_numbers": true,
	},
	"ui_font_weight": 400.0,
	"buffer_font_weight": 400.0,
	"auto_update": false,
	"ensure_final_newline_on_save": false,
	"title_bar": {
		"show_user_picture": false,
  "show_user_menu": true,
  "show_branch_status_icon": true,
		"show_menus": false,
		"button_layout": "platform_default",
		"show_sign_in": false,
	},
	"agent": {
		"sandbox_permissions": {
   "write_paths": [
    "~/Projects"
   ],
   "allow_all_hosts": true,
   "allow_fs_write_all": true
  },
  "inline_assistant_model": {
   "provider": "openai-subscribed",
   "model": "gpt-6-luna",
   "enable_thinking": true
  },
  "tool_permissions": {
   "tools": {
    "terminal": {
     "default": "allow",
     "always_allow": [
      {
       "pattern": "^git\\b"
      },
      {
       "pattern": "^rg\\b"
      },
      {
       "pattern": "^go\\s+test(\\s|$)"
      },
      {
       "pattern": "^gofmt\\b"
      },
      {
       "pattern": "^go\\s+doc(\\s|$)"
      },
      {
       "pattern": "^sed\\b"
      },
      {
       "pattern": "^ls\\b"
      },
      {
       "pattern": "^grep\\b"
      },
      {
       "pattern": "^make\\s+openapi-check(\\s|$)"
      },
      {
       "pattern": "^wc\\b"
      },
      {
       "pattern": "^make\\s+openapi-gen(\\s|$)"
      },
      {
       "pattern": "^GOCACHE=/tmp/go-build\\s+go\\s+test(\\s|$)"
      },
      {
       "pattern": "^find\\s+\\.(\\s|$)"
      },
      {
       "pattern": "^sort\\b"
      }
     ]
    }
   }
  },
  "default_profile": "write",
  "profiles": {

  },
  "default_model": {
   "effort": "medium",
   "provider": "zed.dev",
   "model": "claude-opus-5-5",
   "enable_thinking": true
  },
  "dock": "left",
	},
	"icon_theme": "Colored Zed Icons Theme Dark",
	"buffer_font_family": "Noto Sans Mono",
	"ui_font_family": "Noto Sans",
	"ui_font_size": 16,
	"buffer_font_size": 16.0,
	"theme": "One Dark - Darkened",
	"restore_on_startup": "empty_tab",
	"close_on_file_delete": true,
	"middle_click_paste": false,
	"format_on_save": "off",
	"vim_mode": false,
	"project_panel": {
		"hide_gitignore": false,
		"hide_root": false,
		"folder_icons": true,
		"file_icons": true,
		"dock": "right",
	},
	"minimap": {
		"thumb_border": "left_open",
		"thumb": "always",
		"display_in": "all_editors",
		"show": "always",
	},
	"remove_trailing_whitespace_on_save": true,
	"private_files": [
		"**/.env",
		"**/*.pem",
		"**/*.key",
		"**/*.cert",
		"**/*.crt",
		"**/secrets.yml",
		"**/secrets.sh",
	],
	"languages": {
		"Python": {
			"tab_size": 3,
			"hard_tabs": true,
			"remove_trailing_whitespace_on_save": false,
		},
		"GDScript": {
			"tab_size": 3,
			"hard_tabs": true,
			"remove_trailing_whitespace_on_save": false,
		},
		"Svelte": {
			"tab_size": 2,
			"hard_tabs": false,
			"soft_wrap": "editor_width",
		},
		"HTML": {
			"tab_size": 2,
			"hard_tabs": false,
			"soft_wrap": "editor_width",
		},
		"CSS": {
			"tab_size": 2,
			"hard_tabs": false,
		},
		"SCSS": {
			"tab_size": 2,
			"hard_tabs": false,
		},
	},
}
